+++ b/sistema/registro.js
@@ -0,0 +1,198 @@
+/* /registro — Módulo 1: registro de estudiantes */
+import { CONFIG } from "./config.js";
+import { options, label, errorText } from "./i18n.js";
+import { validateIntake, firstName } from "./core.js";
+import { $, $$, esc, html, mount, setBusy, showFieldErrors, clearFieldErrors, clearErrorsOnEdit, saveRef, toast } from "./ui.js";
+import {
+  loadPublicConfig, fillCountrySelect, linkPhonePrefix, guessCountry, sourceParam, availabilityFrom,
+  renderConsent, contactPayload, makeSubmitter, fatal, journeyState
+} from "./public.js";
+import { rpc } from "./api.js";
+
+const form = $("#form");
+const app = $("#app");
+let cfg = null;
+const submit = makeSubmitter("sms_register");
+
+function chipsFor(container) {
+  const name = container.dataset.chips || container.dataset.checks;
+  const multi = !!container.dataset.checks;
+  const list = options(container.dataset.group);
+  container.innerHTML = list.map((o) =>
+    `<label class="chip"><input type="${multi ? "checkbox" : "radio"}" name="${name}" value="${esc(o.value)}"><span>${esc(o.label)}</span></label>`
+  ).join("");
+}
+
+function renderExtra(questions) {
+  const box = $("#extra-questions");
+  mount(box, html`${questions.map((q) => {
+    const id = "extra_" + q.id;
+    const opt = q.required ? "" : html` <span class="opt">(opcional)</span>`;
+    if (q.type === "checkbox") {
+      return html`<div class="field" data-field="${id}"><div class="check">
+        <input type="checkbox" id="${id}" data-extra="${q.id}" data-type="checkbox">
+        <label for="${id}">${q.label}${opt}</label></div></div>`;
+    }
+    if (q.type === "select") {
+      return html`<div class="field" data-field="${id}"><label for="${id}">${q.label}${opt}</label>
+        <select class="input" id="${id}" data-extra="${q.id}"><option value="">Elige una opción</option>
+        ${q.options.map((o) => html`<option>${o}</option>`)}</select></div>`;
+    }
+    const tag = q.type === "textarea"
+      ? html`<textarea class="input" id="${id}" data-extra="${q.id}" maxlength="1000"></textarea>`
+      : html`<input class="input" id="${id}" data-extra="${q.id}" maxlength="200">`;
+    return html`<div class="field" data-field="${id}"><label for="${id}">${q.label}${opt}</label>${tag}</div>`;
+  })}`);
+}
+
+function collect() {
+  const radio = (n) => (form.querySelector(`input[name="${n}"]:checked`) || {}).value || "";
+  const extra = {};
+  $$("[data-extra]", form).forEach((el) => {
+    extra[el.dataset.extra] = el.dataset.type === "checkbox" ? el.checked : el.value.trim();
+  });
+  const p = {
+    ...contactPayload(form, cfg),
+    english_level: radio("english_level"),
+    objective: radio("objective"),
+    objective_other: radio("objective") === "other" ? form.elements.objective_other.value.trim() : "",
+    preferred_format: radio("preferred_format"),
+    preferred_contact: radio("preferred_contact"),
+    availability: availabilityFrom(form),
+    professional_goals: form.elements.professional_goals.value.trim(),
+    comments: form.elements.comments.value.trim(),
+    referral_source: form.elements.referral_source.value,
+    extra,
+    source: sourceParam()
+  };
+  return p;
+}
+
+function showDone(res) {
+  journeyState(2);
+  $("#mini-label").textContent = "Paso 2 de 4: elige cómo seguir";
+  saveRef(res.ref, res.first_name);
+  form.hidden = true;
+  $("h2", app).hidden = true;
+  $(".lede", app).hidden = true;
+  const done = $("#done");
+  done.hidden = false;
+  const bookingHref = "../reservar/#ref=" + encodeURIComponent(res.ref);
+  mount(done, html`
+    <div class="done-card">
+      <h2 tabindex="-1" id="done-title">Listo, ${res.first_name || "gracias"}. Recibimos tu registro.</h2>
+      <p class="lede">Te escribiremos por el medio que elegiste. Mientras tanto, elige el siguiente paso:</p>
+      <div class="next-list">
+        ${res.next && res.next.booking ? html`
+        <div class="next featured">
+          <div><h3>Reservar mi sesión de diagnóstico</h3><p>Elige día y hora. Te confirmamos por WhatsApp.</p></div>
+          <a class="btn btn-primary" href="${bookingHref}">Ver horarios</a>
+        </div>` : ""}
+        ${res.next && res.next.waitlist ? html`
+        <div class="next" id="wl-card">
+          <div><h3>Unirme a la lista de espera</h3><p>Si no ves un horario que te sirva, te avisamos cuando se abra un cupo.</p></div>
+          <button class="btn btn-soft" type="button" id="wl-btn">Unirme a la lista</button>
+        </div>` : ""}
+        <div class="next">
+          <div><h3>Hablar con nosotros</h3><p>¿Tienes una pregunta antes de seguir?</p></div>
+          <a class="btn btn-soft" target="_blank" rel="noopener"
+             href="https://wa.me/${CONFIG.whatsapp.replace(/\D/g, "")}?text=${encodeURIComponent("Hola, acabo de registrarme en ProfGermandario. Mi nombre es " + (res.first_name || "") + ".")}">Abrir WhatsApp</a>
+        </div>
+      </div>
+    </div>`);
+  $("#done-title").focus();
+  const wlBtn = $("#wl-btn");
+  if (wlBtn) wlBtn.addEventListener("click", () => joinWaitlist(res.ref, wlBtn));
+}
+
+const waitlistSubmit = makeSubmitter("sms_join_waitlist");
+async function joinWaitlist(ref, btn) {
+  setBusy(btn, true, "Uniéndote…");
+  try {
+    const r = await waitlistSubmit({ ref });
+    if (r && r.ok) {
+      const card = $("#wl-card");
+      mount(card, r.state === "waitlist"
+        ? html`<div><h3>Estás en la lista de espera</h3><p>Tu posición actual: <b>${r.position}</b>. El orden es por fecha de registro; te avisamos apenas se abra un cupo.</p></div>`
+        : html`<div><h3>Tu solicitud ya está en proceso</h3><p>Estado: ${label("lead", r.state)}. Te contactaremos pronto.</p></div>`);
+    } else {
+      const [field, code] = Object.entries((r && r.errors) || { form: "invalid" })[0];
+      toast(errorText(field, code), "err", 6000);
+      setBusy(btn, false);
+    }
+  } catch (e) {
+    toast(errorText("network", e.code === "network" ? "network" : "generic"), "err", 6000);
+    setBusy(btn, false);
+  }
+}
+
+async function onSubmit(ev) {
+  ev.preventDefault();
+  const alertBox = $("#form-alert");
+  alertBox.hidden = true;
+  const p = collect();
+  const errors = validateIntake(p, "register", cfg);
+  if (Object.keys(errors).length) {
+    const first = showFieldErrors(form, errors);
+    if (first && first.el) first.el.focus();
+    alertBox.textContent = "Revisa los campos marcados para continuar.";
+    alertBox.hidden = false;
+    return;
+  }
+  clearFieldErrors(form);
+  const btn = $("#submit");
+  setBusy(btn, true, "Enviando…");
+  try {
+    const res = await submit(p);
+    if (res && res.ok) {
+      showDone(res);
+      return;
+    }
+    const errs = (res && res.errors) || { form: "invalid" };
+    const first = showFieldErrors(form, errs);
+    alertBox.textContent = errs.form ? errorText("form", errs.form) : "Revisa los campos marcados para continuar.";
+    alertBox.hidden = false;
+    if (errs.consent_privacy === "outdated") setTimeout(() => location.reload(), 2500);
+    (first && first.el ? first.el : alertBox).focus?.();
+  } catch (e) {
+    alertBox.textContent = errorText("network", e.code === "network" ? "network" : "generic");
+    alertBox.hidden = false;
+  } finally {
+    setBusy(btn, false);
+  }
+}
+
+async function init() {
+  try {
+    cfg = await loadPublicConfig();
+  } catch (e) {
+    $("#loading").remove();
+    fatal(app, e);
+    return;
+  }
+  $$("[data-chips],[data-checks]", form).forEach(chipsFor);
+  fillCountrySelect(form.elements.country, guessCountry());
+  linkPhonePrefix(form.elements.country, form.elements.whatsapp)();
+
+  const show = cfg.show_optional_fields || {};
+  $$("[data-optional]", form).forEach((el) => { el.hidden = show[el.dataset.optional] === false; });
+  const ref = form.elements.referral_source;
+  ref.innerHTML = `<option value="">Elige una opción</option>` +
+    (cfg.referral_options || []).map((o) => `<option>${esc(o)}</option>`).join("");
+  renderExtra(cfg.extra_questions || []);
+  if ($$("[data-optional]:not([hidden])", form).length === 0 && !(cfg.extra_questions || []).length) $("#optional-set").hidden = true;
+
+  renderConsent($("#consent"), cfg,
+    "gestionar tu registro, contactarte sobre tu proceso de inglés, agendar sesiones y hacer seguimiento a tu progreso.");
+
+  form.addEventListener("change", (e) => {
+    if (e.target.name === "objective") $("#objective-other-wrap").hidden = e.target.value !== "other";
+  });
+  clearErrorsOnEdit(form);
+  form.addEventListener("submit", onSubmit);
+  $("#loading").remove();
+  form.hidden = false;
+  $("#mini-label").textContent = "Paso 1 de 4: registro";
+}
+
+init();
diff --git a/sistema/reservar.js b/sistema/reservar.js
new file mode 100644
index 0000000..a67d128
--- /dev/null
+++ b/sistema/reservar.js
@@ -0,0 +1,230 @@
+/* /reservar — Módulo 3 (parte pública): elegir y solicitar un horario */
+import { CONFIG } from "./config.js";
+import { label, errorText } from "./i18n.js";
+import { validateIntake, browserTimeZone, groupSlotsByDay, fmtTime, fmtDate } from "./core.js";
+import { $, $$, esc, html, mount, setBusy, showFieldErrors, clearFieldErrors, clearErrorsOnEdit, readRef, saveRef, forgetRef, toast, download } from "./ui.js";
+import {
+  loadPublicConfig, fillCountrySelect, linkPhonePrefix, guessCountry, sourceParam,
+  renderConsent, contactPayload, makeSubmitter, fatal, journeyState
+} from "./public.js";
+import { rpc } from "./api.js";
+
+const viewerTz = browserTimeZone();
+const submit = makeSubmitter("sms_request_booking");
+let cfg = null;
+let saved = null;
+let slots = [];
+let chosenDay = null;
+let chosen = null;
+
+async function loadSlots() {
+  const r = await rpc("sms_public_slots", { p_from: null, p_days: 31 });
+  slots = (r && r.slots) || [];
+  return r;
+}
+
+function renderDays() {
+  const groups = groupSlotsByDay(slots, viewerTz);
+  const days = $("#days");
+  if (!groups.length) return false;
+  if (!chosenDay || !groups.some((g) => g.day === chosenDay)) chosenDay = groups[0].day;
+  days.innerHTML = groups.map((g) => {
+    const d = new Date(g.items[0].start);
+    const wd = new Intl.DateTimeFormat("es", { timeZone: viewerTz, weekday: "short" }).format(d);
+    const dn = new Intl.DateTimeFormat("es", { timeZone: viewerTz, day: "numeric" }).format(d);
+    const mo = new Intl.DateTimeFormat("es", { timeZone: viewerTz, month: "short" }).format(d);
+    return `<button type="button" class="day-btn" data-day="${g.day}" aria-pressed="${g.day === chosenDay}">
+      <small>${esc(wd)}</small><b>${esc(dn)}</b><small>${esc(mo)}</small></button>`;
+  }).join("");
+  renderTimes();
+  return true;
+}
+
+function renderTimes() {
+  const group = groupSlotsByDay(slots, viewerTz).find((g) => g.day === chosenDay);
+  $("#times").innerHTML = (group ? group.items : []).map((s) =>
+    `<button type="button" class="time-btn" data-start="${esc(s.start)}" aria-pressed="${chosen && chosen.start === s.start}">${esc(fmtTime(s.start, viewerTz))}</button>`
+  ).join("");
+  $$(".day-btn").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.day === chosenDay)));
+}
+
+function pick(start) {
+  chosen = slots.find((s) => s.start === start) || null;
+  renderTimes();
+  const p = $("#picked");
+  const btn = $("#submit");
+  if (!chosen) { p.hidden = true; btn.disabled = true; btn.textContent = "Elige un horario"; return; }
+  const when = fmtDate(chosen.start, viewerTz, { weekday: "long", day: "numeric", month: "long", year: undefined, hour: "numeric", minute: "2-digit" });
+  let txt = `${label("session", chosen.type)}: ${when}`;
+  if (cfg.timezone && cfg.timezone !== viewerTz) {
+    txt += ` (en Colombia: ${fmtTime(chosen.start, cfg.timezone)})`;
+  }
+  p.textContent = txt;
+  p.hidden = false;
+  btn.disabled = false;
+  btn.textContent = cfg.booking_auto_confirm ? "Reservar este horario" : "Solicitar este horario";
+  const wrap = $('[data-field="slot"]');
+  wrap.classList.remove("has-error");
+  const m = wrap.querySelector(".field-error"); if (m) m.remove();
+}
+
+function icsFor(b) {
+  const f = (iso) => new Date(iso).toISOString().replace(/[-:]/g, "").replace(/\.\d{3}/, "");
+  return [
+    "BEGIN:VCALENDAR", "VERSION:2.0", "PRODID:-//ProfGermandario//Reservas//ES", "BEGIN:VEVENT",
+    "UID:" + f(b.start) + "-profgermandario", "DTSTAMP:" + f(new Date().toISOString()),
+    "DTSTART:" + f(b.start), "DTEND:" + f(b.end),
+    "SUMMARY:" + label("session", b.type) + " · ProfGermandario",
+    "DESCRIPTION:" + (b.status === "confirmed" ? "Sesión confirmada." : "Solicitud pendiente de confirmación por WhatsApp."),
+    "END:VEVENT", "END:VCALENDAR"
+  ].join("\r\n");
+}
+
+function showDone(r) {
+  saveRef(r.ref, r.first_name);
+  journeyState(3);
+  $("#form").hidden = true;
+  $("#title").hidden = true;
+  $("#lede").hidden = true;
+  const b = r.booking;
+  const when = fmtDate(b.start, viewerTz, { weekday: "long", day: "numeric", month: "long", year: undefined, hour: "numeric", minute: "2-digit" });
+  const confirmed = b.status === "confirmed";
+  const done = $("#done");
+  done.hidden = false;
+  mount(done, html`
+    <h2 tabindex="-1" id="done-title">${confirmed ? "Sesión reservada" : "Solicitud enviada"}${r.first_name ? ", " + r.first_name : ""}.</h2>
+    <div class="form-card done-card">
+      <p style="margin:0;color:var(--muted)">${label("session", b.type)}</p>
+      <p style="font-size:24px;font-weight:900;letter-spacing:-.03em;margin:4px 0 12px;text-transform:capitalize">${when}</p>
+      <p>${confirmed
+        ? "Tu horario quedó confirmado. Te enviaremos el enlace de la sesión por WhatsApp."
+        : "Revisamos tu solicitud y te confirmamos por WhatsApp. El horario queda apartado para ti mientras tanto."}</p>
+      <div class="btn-row" style="margin-top:18px">
+        <button class="btn btn-dark" type="button" id="ics">Agregar a mi calendario</button>
+        <a class="btn btn-soft" target="_blank" rel="noopener"
+           href="https://wa.me/${CONFIG.whatsapp.replace(/\D/g, "")}?text=${encodeURIComponent("Hola, acabo de solicitar una sesión para el " + when + ".")}">Escribir por WhatsApp</a>
+      </div>
+    </div>`);
+  $("#ics").addEventListener("click", () => download("sesion-profgermandario.ics", icsFor(b), "text/calendar;charset=utf-8"));
+  $("#done-title").focus();
+}
+
+async function onSubmit(ev) {
+  ev.preventDefault();
+  const form = ev.currentTarget;
+  const alertBox = $("#form-alert");
+  alertBox.hidden = true;
+  if (!chosen) {
+    showFieldErrors(form, { slot: "required" });
+    return;
+  }
+  let p = { slot_start: chosen.start, message: form.elements.message.value.trim() };
+  if (saved) {
+    p.ref = saved.ref;
+  } else {
+    p = { ...contactPayload(form, cfg), ...p, source: sourceParam() };
+    const errors = validateIntake(p, "booking", cfg);
+    if (Object.keys(errors).length) {
+      const first = showFieldErrors(form, errors);
+      alertBox.textContent = "Revisa los campos marcados para continuar.";
+      alertBox.hidden = false;
+      if (first && first.el) first.el.focus();
+      return;
+    }
+  }
+  clearFieldErrors(form);
+  const btn = $("#submit");
+  setBusy(btn, true, "Enviando…");
+  try {
+    const r = await submit(p);
+    if (r && r.ok) return showDone(r);
+    const errs = (r && r.errors) || { form: "invalid" };
+    if (errs.slot === "unavailable" || errs.slot === "taken") {
+      toast(errorText("slot", errs.slot), "err", 6000);
+      chosen = null;
+      await loadSlots();
+      if (!renderDays()) return showNoSlots();
+      pick(null);
+      return;
+    }
+    if (errs.ref) {
+      forgetRef(); saved = null;
+      $("#contact-set").hidden = false; $("#consent-set").hidden = false; $("#as-ref").hidden = true;
+    }
+    const first = showFieldErrors(form, errs);
+    const [field, code] = Object.entries(errs)[0];
+    alertBox.textContent = errorText(field, code);
+    alertBox.hidden = false;
+    if (first && first.el) first.el.focus();
+  } catch (e) {
+    alertBox.textContent = errorText("network", e.code === "network" ? "network" : "generic");
+    alertBox.hidden = false;
+  } finally {
+    setBusy(btn, false);
+    if (!chosen) { btn.disabled = true; btn.textContent = "Elige un horario"; }
+  }
+}
+
+function showNoSlots(disabled) {
+  $("#form").hidden = true;
+  $("#lede").hidden = true;
+  const done = $("#done");
+  done.hidden = false;
+  mount(done, html`<div class="empty">
+      <p style="margin:0 0 6px;font-weight:800;color:var(--ink)">${disabled ? "Las reservas en línea están pausadas." : "No hay horarios disponibles en las próximas semanas."}</p>
+      <p style="margin:0 0 16px">Únete a la lista de espera y te avisamos apenas se abra un espacio.</p>
+      <div class="btn-row" style="justify-content:center">
+        <a class="btn btn-primary" href="../lista-de-espera/${saved ? "#ref=" + encodeURIComponent(saved.ref) : ""}">Unirme a la lista de espera</a>
+        <a class="btn btn-soft" target="_blank" rel="noopener" href="https://wa.me/${CONFIG.whatsapp.replace(/\D/g, "")}">Escribir por WhatsApp</a>
+      </div></div>`);
+}
+
+async function init() {
+  const app = $("#app");
+  saved = readRef();
+  let r;
+  try {
+    [cfg, r] = await Promise.all([loadPublicConfig(), loadSlots()]);
+  } catch (e) {
+    $("#loading").remove();
+    return fatal(app, e);
+  }
+  $("#loading").remove();
+  if (!r.enabled) return showNoSlots(true);
+  if (!renderDays()) return showNoSlots(false);
+
+  const form = $("#form");
+  form.hidden = false;
+  const tzName = viewerTz.replace(/_/g, " ");
+  $("#tz-note").textContent = cfg.timezone && cfg.timezone !== viewerTz
+    ? `Horas en tu zona horaria (${tzName}). Al elegir verás también la hora de Colombia.`
+    : `Horas en tu zona horaria (${tzName}).`;
+
+  if (saved) {
+    $("#contact-set").hidden = true;
+    $("#consent-set").hidden = true;
+    const asRef = $("#as-ref");
+    asRef.hidden = false;
+    asRef.innerHTML = `Reservando con los datos de tu registro${saved.first_name ? " (" + esc(saved.first_name) + ")" : ""}. <a href="#" id="not-me">¿No eres tú?</a>`;
+    $("#not-me").addEventListener("click", (e) => {
+      e.preventDefault(); forgetRef(); saved = null;
+      asRef.hidden = true; $("#contact-set").hidden = false; $("#consent-set").hidden = false;
+    });
+  }
+  fillCountrySelect(form.elements.country, guessCountry());
+  linkPhonePrefix(form.elements.country, form.elements.whatsapp)();
+  renderConsent($("#consent"), cfg, "agendar tu sesión, confirmarla contigo y hacer seguimiento a tu proceso.");
+
+  $("#days").addEventListener("click", (e) => {
+    const b = e.target.closest(".day-btn"); if (!b) return;
+    chosenDay = b.dataset.day; renderTimes();
+  });
+  $("#times").addEventListener("click", (e) => {
+    const b = e.target.closest(".time-btn"); if (!b) return;
+    pick(b.dataset.start);
+  });
+  form.addEventListener("submit", onSubmit);
+  clearErrorsOnEdit(form);
+}
+
+init();
