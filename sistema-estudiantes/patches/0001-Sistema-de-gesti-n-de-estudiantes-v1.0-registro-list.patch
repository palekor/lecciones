@@ -0,0 +1,153 @@
+/* /lista-de-espera — Módulo 2 (parte pública) */
+import { CONFIG } from "./config.js";
+import { options, label, errorText } from "./i18n.js";
+import { validateIntake } from "./core.js";
+import { $, $$, esc, html, mount, setBusy, showFieldErrors, clearFieldErrors, clearErrorsOnEdit, readRef, saveRef, forgetRef } from "./ui.js";
+import {
+  loadPublicConfig, fillCountrySelect, linkPhonePrefix, guessCountry, sourceParam, availabilityFrom,
+  renderConsent, contactPayload, makeSubmitter, fatal, journeyState
+} from "./public.js";
+
+const submit = makeSubmitter("sms_join_waitlist");
+let cfg = null;
+
+function chipsFor(container) {
+  const name = container.dataset.chips || container.dataset.checks;
+  const multi = !!container.dataset.checks;
+  container.innerHTML = options(container.dataset.group).map((o) =>
+    `<label class="chip"><input type="${multi ? "checkbox" : "radio"}" name="${name}" value="${esc(o.value)}"><span>${esc(o.label)}</span></label>`).join("");
+}
+
+function showDone(r) {
+  saveRef(r.ref, r.first_name);
+  $("#quick").hidden = true;
+  $("#full").hidden = true;
+  const done = $("#done");
+  done.hidden = false;
+  const order = cfg.waitlist_order === "joined" ? "fecha de ingreso a la lista" : "fecha de registro";
+  if (r.state === "waitlist") {
+    mount(done, html`
+      <h2 tabindex="-1" id="done-title">${r.first_name ? r.first_name + ", ya" : "Ya"} tienes tu lugar.</h2>
+      <div class="form-card done-card">
+        <p style="margin:0;color:var(--muted)">Tu posición en la lista</p>
+        <p class="big-number">${r.position}</p>
+        <p>El orden es por <b>${order}</b>. En casos puntuales (por ejemplo, una entrevista con fecha cercana) podemos priorizar; si es tu caso, cuéntanos por WhatsApp.</p>
+        <div class="btn-row" style="margin-top:18px">
+          <a class="btn btn-primary" href="../reservar/#ref=${encodeURIComponent(r.ref)}">Ver si hay horarios hoy</a>
+          <a class="btn btn-soft" target="_blank" rel="noopener" href="https://wa.me/${CONFIG.whatsapp.replace(/\D/g, "")}">Escribir por WhatsApp</a>
+        </div>
+      </div>`);
+  } else {
+    const msg = r.state === "active_student"
+      ? "Ya eres estudiante activo: no necesitas la lista de espera. Escríbenos si quieres agendar."
+      : "Tu solicitud ya avanzó (" + label("lead", r.state).toLowerCase() + "). Te contactaremos pronto.";
+    mount(done, html`<h2 tabindex="-1" id="done-title">Todo listo${r.first_name ? ", " + r.first_name : ""}.</h2>
+      <div class="form-card"><p style="margin:0">${msg}</p></div>`);
+  }
+  journeyState(2);
+  $("#done-title").focus();
+}
+
+function showErrors(form, alertBox, res) {
+  const errs = (res && res.errors) || { form: "invalid" };
+  const first = form ? showFieldErrors(form, errs) : null;
+  const [field, code] = Object.entries(errs)[0];
+  alertBox.textContent = errs.form || errs.ref || !form ? errorText(field, code) : "Revisa los campos marcados para continuar.";
+  alertBox.hidden = false;
+  if (first && first.el) first.el.focus();
+}
+
+async function quickJoin(ref) {
+  const btn = $("#quick-btn");
+  const alertBox = $("#quick-alert");
+  alertBox.hidden = true;
+  setBusy(btn, true, "Guardando tu lugar…");
+  try {
+    const r = await submit({ ref });
+    if (r && r.ok) return showDone(r);
+    if (r && r.errors && r.errors.ref) { forgetRef(); showFull(); $("#form-alert").textContent = errorText("ref", "invalid"); $("#form-alert").hidden = false; return; }
+    showErrors(null, alertBox, r);
+  } catch (e) {
+    alertBox.textContent = errorText("network", e.code === "network" ? "network" : "generic");
+    alertBox.hidden = false;
+  } finally {
+    setBusy(btn, false);
+  }
+}
+
+function showFull() {
+  $("#quick").hidden = true;
+  $("#full").hidden = false;
+}
+
+async function onSubmit(ev) {
+  ev.preventDefault();
+  const form = ev.currentTarget;
+  const alertBox = $("#form-alert");
+  alertBox.hidden = true;
+  const radio = (n) => (form.querySelector(`input[name="${n}"]:checked`) || {}).value || "";
+  const p = {
+    ...contactPayload(form, cfg),
+    objective: radio("objective"),
+    objective_other: radio("objective") === "other" ? form.elements.objective_other.value.trim() : "",
+    preferred_format: radio("preferred_format"),
+    availability: availabilityFrom(form),
+    source: sourceParam()
+  };
+  const errors = validateIntake(p, "waitlist", cfg);
+  if (Object.keys(errors).length) return showErrors(form, alertBox, { errors: { ...errors } });
+  clearFieldErrors(form);
+  const btn = $("#submit");
+  setBusy(btn, true, "Enviando…");
+  try {
+    const r = await submit(p);
+    if (r && r.ok) return showDone(r);
+    showErrors(form, alertBox, r);
+    if (r && r.errors && r.errors.consent_privacy === "outdated") setTimeout(() => location.reload(), 2500);
+  } catch (e) {
+    alertBox.textContent = errorText("network", e.code === "network" ? "network" : "generic");
+    alertBox.hidden = false;
+  } finally {
+    setBusy(btn, false);
+  }
+}
+
+async function init() {
+  const app = $("#app");
+  try {
+    cfg = await loadPublicConfig();
+  } catch (e) {
+    $("#loading").remove();
+    return fatal(app, e);
+  }
+  $("#loading").remove();
+  if (!cfg.waitlist_enabled) {
+    mount(app, html`<h2>La lista de espera está cerrada</h2>
+      <p class="lede">En este momento no estamos sumando personas a la lista. Puedes revisar horarios disponibles o escribirnos.</p>
+      <div class="btn-row"><a class="btn btn-primary" href="../reservar/">Ver horarios</a>
+      <a class="btn btn-soft" target="_blank" rel="noopener" href="https://wa.me/${CONFIG.whatsapp.replace(/\D/g, "")}">Escribir por WhatsApp</a></div>`);
+    return;
+  }
+  const form = $("#form");
+  $$("[data-chips],[data-checks]", form).forEach(chipsFor);
+  fillCountrySelect(form.elements.country, guessCountry());
+  linkPhonePrefix(form.elements.country, form.elements.whatsapp)();
+  renderConsent($("#consent"), cfg, "guardar tu lugar en la lista de espera y avisarte cuando se abra un cupo.");
+  form.addEventListener("change", (e) => {
+    if (e.target.name === "objective") $("#objective-other-wrap").hidden = e.target.value !== "other";
+  });
+  form.addEventListener("submit", onSubmit);
+  clearErrorsOnEdit(form);
+
+  const saved = readRef();
+  if (saved) {
+    $("#quick").hidden = false;
+    if (saved.first_name) $("#quick-title").textContent = `${saved.first_name}, ¿te sumamos a la lista de espera?`;
+    $("#quick-btn").addEventListener("click", () => quickJoin(saved.ref));
+    $("#not-me").addEventListener("click", (e) => { e.preventDefault(); forgetRef(); showFull(); });
+  } else {
+    showFull();
+  }
+}
+
+init();
diff --git a/sistema/public.js b/sistema/public.js
new file mode 100644
index 0000000..9f0f020
--- /dev/null
+++ b/sistema/public.js
@@ -0,0 +1,158 @@
+/* =====================================================================
+   Piezas compartidas por las páginas públicas (/registro, /lista-de-espera,
+   /reservar): configuración, país/teléfono, privacidad, envío seguro.
+   ===================================================================== */
+import { rpc, ApiError } from "./api.js";
+import { CONFIG } from "./config.js";
+import { countryList, DIAL_CODES, browserTimeZone, uuid, cleanAvailability, normalizeName } from "./core.js";
+import { $, $$, esc, html, mount, raw } from "./ui.js";
+import { errorText } from "./i18n.js";
+
+let cfgP = null;
+export function loadPublicConfig() {
+  if (!cfgP) cfgP = rpc("sms_public_config").catch((e) => { cfgP = null; throw e; });
+  return cfgP;
+}
+
+export function fillCountrySelect(select, preselect) {
+  const { priority, rest } = countryList("es");
+  const opt = (c) => `<option value="${c.code}">${esc(c.name)}</option>`;
+  select.innerHTML = `<option value="">Selecciona tu país</option>
+    <optgroup label="Más frecuentes">${priority.map(opt).join("")}</optgroup>
+    <optgroup label="Todos los países">${rest.map(opt).join("")}</optgroup>`;
+  if (preselect) select.value = preselect;
+}
+
+/** Al elegir país, propone el indicativo en el campo de WhatsApp si está vacío. */
+export function linkPhonePrefix(countrySel, phoneInput) {
+  const apply = () => {
+    const dial = DIAL_CODES[countrySel.value];
+    const digits = phoneInput.value.replace(/\D/g, "");
+    if (dial && digits.length <= 4) phoneInput.value = "+" + dial + " ";
+  };
+  countrySel.addEventListener("change", apply);
+  return apply;
+}
+
+/** Sugerencia de país por zona horaria del navegador (sin geolocalización). */
+export function guessCountry() {
+  const tz = browserTimeZone();
+  const map = {
+    "America/Bogota": "CO", "America/Mexico_City": "MX", "America/Monterrey": "MX", "America/Tijuana": "MX",
+    "America/Argentina/Buenos_Aires": "AR", "America/Buenos_Aires": "AR", "America/Santiago": "CL", "America/Lima": "PE",
+    "America/Guayaquil": "EC", "America/Caracas": "VE", "America/La_Paz": "BO", "America/Asuncion": "PY",
+    "America/Montevideo": "UY", "America/Costa_Rica": "CR", "America/Panama": "PA", "America/Guatemala": "GT",
+    "America/Tegucigalpa": "HN", "America/El_Salvador": "SV", "America/Managua": "NI", "America/Santo_Domingo": "DO",
+    "America/Puerto_Rico": "PR", "America/Havana": "CU", "Europe/Madrid": "ES", "Atlantic/Canary": "ES"
+  };
+  return map[tz] || "";
+}
+
+export function sourceParam() {
+  try {
+    const q = new URLSearchParams(location.search);
+    const s = (q.get("src") || q.get("utm_source") || "").toLowerCase();
+    return /^[a-z0-9_.-]{1,60}$/.test(s) ? s : undefined;
+  } catch (e) { return undefined; }
+}
+
+export function availabilityFrom(form) {
+  return cleanAvailability({
+    days: $$('input[name="av_day"]:checked', form).map((i) => i.value),
+    times: $$('input[name="av_time"]:checked', form).map((i) => i.value),
+    notes: form.elements.av_notes ? form.elements.av_notes.value : "",
+    tz: browserTimeZone()
+  });
+}
+
+/** Aviso de privacidad resumido + casillas de consentimiento (marketing nunca premarcado). */
+export function renderConsent(container, cfg, purpose) {
+  const url = cfg.privacy_policy_url || "../privacidad/";
+  mount(container, html`
+    <div class="privacy-box">
+      <p><b>Para qué usamos tus datos:</b> ${purpose}</p>
+      <p>Responsable: ${cfg.controller_name || CONFIG.brand}. No vendemos ni compartimos tus datos con terceros para su publicidad.
+         Puedes conocer, actualizar, corregir o pedir que eliminemos tus datos en cualquier momento escribiendo a
+         ${cfg.contact_email || ""}.</p>
+      <p><a href="${url}" target="_blank" rel="noopener">Leer la política de tratamiento de datos completa</a> (versión ${cfg.privacy_notice_version || ""}).</p>
+    </div>
+    <div data-field="consent_privacy">
+      <div class="check">
+        <input type="checkbox" id="consent_privacy" name="consent_privacy" required>
+        <label for="consent_privacy">Autorizo el tratamiento de mis datos personales para gestionar mi solicitud, según la política de tratamiento de datos.</label>
+      </div>
+    </div>
+    <div class="check">
+      <input type="checkbox" id="consent_marketing" name="consent_marketing">
+      <label for="consent_marketing">Quiero recibir novedades, contenidos y ofertas de ${CONFIG.brand} por WhatsApp o correo. <span class="opt">(Opcional — puedes darte de baja cuando quieras.)</span></label>
+    </div>`);
+}
+
+export function contactPayload(form, cfg) {
+  return {
+    full_name: normalizeName(form.elements.full_name.value),
+    email: form.elements.email.value.trim(),
+    whatsapp: form.elements.whatsapp.value.trim(),
+    country: form.elements.country.value,
+    consent_privacy: form.elements.consent_privacy.checked,
+    consent_marketing: form.elements.consent_marketing ? form.elements.consent_marketing.checked : false,
+    notice_version: cfg.privacy_notice_version,
+    website: form.elements.website ? form.elements.website.value : ""
+  };
+}
+
+/**
+ * Envío con idempotencia: la misma client_key se reutiliza solo para
+ * reintentos de red; tras una respuesta del servidor se genera otra.
+ */
+export function makeSubmitter(fnName) {
+  let key = uuid();
+  const startedAt = Date.now();
+  return async function submit(payload) {
+    const body = { ...payload, client_key: key, elapsed_ms: Date.now() - startedAt };
+    let lastErr;
+    for (let attempt = 0; attempt < 3; attempt++) {
+      try {
+        const res = await rpc(fnName, { p: body });
+        if (!res || !res.ok) key = uuid();
+        return res;
+      } catch (e) {
+        lastErr = e;
+        if (!(e instanceof ApiError) || e.code !== "network") break;
+        await new Promise((r) => setTimeout(r, 800 * (attempt + 1)));
+      }
+    }
+    key = uuid();
+    throw lastErr;
+  };
+}
+
+export function fatal(container, err) {
+  const msg = err && err.code === "network" ? errorText("network", "network") : errorText("generic", "generic");
+  mount(container, html`
+    <div class="form-card">
+      <h2 style="margin-top:0">No pudimos cargar el formulario</h2>
+      <p class="lede">${msg}</p>
+      <div class="btn-row">
+        <button class="btn btn-dark" type="button" onclick="location.reload()">Volver a intentar</button>
+        <a class="btn btn-soft" href="https://wa.me/${CONFIG.whatsapp.replace(/\D/g, "")}" target="_blank" rel="noopener">Escribir por WhatsApp</a>
+      </div>
+    </div>`);
+}
+
+export function journeyState(at) {
+  $$(".journey").forEach((ol) => {
+    ol.dataset.at = String(at);
+    $$("li", ol).forEach((li, i) => {
+      li.classList.toggle("done", i + 1 < at);
+      li.classList.toggle("now", i + 1 === at);
+    });
+  });
+  $$(".mini-journey").forEach((mj) => {
+    $$("i", mj).forEach((dot, i) => {
+      dot.className = i + 1 < at ? "done" : i + 1 === at ? "now" : "";
+    });
+  });
+}
+
+export { raw };
