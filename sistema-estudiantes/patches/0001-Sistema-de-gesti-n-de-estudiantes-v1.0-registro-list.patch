@@ -0,0 +1,78 @@
+/* Inicio — Módulo 4: panel con indicadores y pendientes del día */
+import { rpc } from "../../api.js";
+import { label } from "../../i18n.js";
+import { LEAD_STATUSES, waLink, countryName } from "../../core.js";
+import { html, mount } from "../../ui.js";
+import { S, dt, d, tm, relative, isOverdue, money } from "../state.js";
+import { badge } from "../widgets.js";
+
+const PIPE_COLORS = {
+  new: "#FF6A1A", contact_pending: "#F2A33A", contacted: "#7A2BD1", waitlist: "#D72B83",
+  invitation_sent: "#A06BE0", booking_requested: "#3B6FD8", converted: "#0E8C79", not_interested: "#B9B2C2", archived: "#DAD5DF"
+};
+
+export async function render(el, _params, ctx) {
+  const k = await rpc("sms_dashboard");
+  if (!ctx.isCurrent()) return;
+  const conv = k.conversion_90d || {};
+  const rate = conv.leads ? Math.round((conv.converted / conv.leads) * 100) : 0;
+  const pipeTotal = LEAD_STATUSES.reduce((a, s) => a + ((k.pipeline || {})[s] || 0), 0);
+  const revenue = k.revenue_month ? Object.entries(k.revenue_month) : null;
+  const hello = S.me.staff.display_name ? `Hola, ${S.me.staff.display_name}` : "Hola";
+
+  mount(el, html`
+    <p class="muted" style="margin:0 0 14px">${hello}. Esto es lo que necesita tu atención hoy.</p>
+    <div class="kpis">
+      <a class="kpi ${k.pending_bookings ? "alert" : ""}" href="#/agenda?f=requested"><b>${k.pending_bookings}</b><span>Sesiones por confirmar</span></a>
+      <a class="kpi ${k.follow_ups_due ? "alert" : ""}" href="#/leads?sort=followup"><b>${k.follow_ups_due}</b><span>Seguimientos para hoy o vencidos</span></a>
+      <a class="kpi" href="#/leads?status=new"><b>${k.new_leads_7d}</b><span>Registros en 7 días</span></a>
+      <a class="kpi" href="#/lista"><b>${k.waitlist}</b><span>En lista de espera</span></a>
+      <a class="kpi" href="#/agenda"><b>${k.sessions_7d}</b><span>Sesiones confirmadas (7 días)</span></a>
+      <a class="kpi" href="#/estudiantes"><b>${k.active_students}</b><span>Estudiantes activos</span></a>
+      ${revenue ? html`<a class="kpi" href="#/pagos"><b>${revenue.length ? revenue.map(([c, v]) => money(v, c)).join(" + ") : money(0, "USD")}</b><span>Cobrado este mes</span></a>` : ""}
+      ${k.payments_overdue !== null && k.payments_overdue !== undefined ? html`<a class="kpi ${k.payments_overdue ? "alert" : ""}" href="#/pagos?f=overdue"><b>${k.payments_overdue}</b><span>Pagos vencidos</span></a>` : ""}
+      <div class="kpi"><b>${rate}%</b><span>Conversión 90 días (${conv.converted} de ${conv.leads})</span></div>
+      <a class="kpi" href="#/estudiantes?f=renewals"><b>${k.renewals_7d}</b><span>Renovaciones en 7 días</span></a>
+    </div>
+
+    <div class="cols">
+      <section class="panel">
+        <h2>Próximas sesiones <span class="spacer"></span><a class="small" href="#/agenda">Ver agenda</a></h2>
+        ${k.upcoming.length ? html`<div>${k.upcoming.map((b) => html`
+          <a class="row" style="--cols: 110px 1fr auto; padding:10px 0; border-top:1px solid var(--line)" href="#/persona/${b.student_id}">
+            <span><b>${tm(b.starts_at)}</b><span class="sub">${d(b.starts_at)}</span></span>
+            <span class="name">${b.full_name}<span class="sub">${label("session", b.session_type)}</span></span>
+            ${badge("booking", b.status)}
+          </a>`)}</div>` : html`<div class="empty-state"><b>No hay sesiones próximas.</b>Activa horarios en Agenda para recibir reservas.</div>`}
+      </section>
+
+      <section class="panel">
+        <h2>Seguimientos pendientes <span class="spacer"></span><a class="small" href="#/leads?sort=followup">Ver todos</a></h2>
+        ${k.follow_ups.length ? html`<div>${k.follow_ups.map((f) => html`
+          <div class="row" style="--cols: 1fr auto; padding:10px 0; border-top:1px solid var(--line)">
+            <a class="name" href="#/persona/${f.student_id}" style="color:inherit;text-decoration:none">${f.full_name}
+              <span class="sub ${isOverdue(f.due) ? "overdue" : ""}">${dt(f.due)} (${relative(f.due)})</span></a>
+            ${f.whatsapp ? html`<a class="btn btn-soft btn-sm" target="_blank" rel="noopener" href="${waLink(f.whatsapp)}">WhatsApp</a>` : ""}
+          </div>`)}</div>` : html`<div class="empty-state"><b>Todo al día.</b>Programa seguimientos desde la ficha de cada persona.</div>`}
+      </section>
+
+      <section class="panel">
+        <h2>Embudo de leads</h2>
+        <div class="pipeline" role="img" aria-label="Distribución de leads por estado">
+          ${LEAD_STATUSES.map((s) => (k.pipeline || {})[s] ? html`<i style="width:${(100 * k.pipeline[s] / pipeTotal).toFixed(2)}%;background:${PIPE_COLORS[s]}" title="${label("lead", s)}: ${k.pipeline[s]}"></i>` : "")}
+        </div>
+        <div class="legend">${LEAD_STATUSES.filter((s) => (k.pipeline || {})[s]).map((s) => html`
+          <a href="#/leads?status=${s}" style="--c:${PIPE_COLORS[s]};color:inherit;text-decoration:none"><span>${label("lead", s)}: <b>${k.pipeline[s]}</b></span></a>`)}</div>
+        ${pipeTotal ? "" : html`<div class="empty-state"><b>Aún no hay leads.</b>Comparte el enlace de registro: <code>/registro/</code></div>`}
+      </section>
+
+      <section class="panel">
+        <h2>Últimos registros <span class="spacer"></span><a class="small" href="#/leads">Ver leads</a></h2>
+        ${k.recent.length ? html`<div>${k.recent.map((r) => html`
+          <a class="row" style="--cols: 1fr auto; padding:10px 0; border-top:1px solid var(--line)" href="#/persona/${r.student_id}">
+            <span class="name">${r.full_name}<span class="sub">${[label("objective", r.objective), countryName(r.country), relative(r.registered_at)].filter(Boolean).join(" · ")}</span></span>
+            ${badge("lead", r.status)}
+          </a>`)}</div>` : html`<div class="empty-state">Sin registros todavía.</div>`}
+      </section>
+    </div>`);
+}
diff --git a/sistema/admin/views/leads.js b/sistema/admin/views/leads.js
new file mode 100644
index 0000000..e7f4ec2
--- /dev/null
+++ b/sistema/admin/views/leads.js
@@ -0,0 +1,172 @@
+/* Leads y lista de espera — Módulo 2 (gestión) */
+import { q, rpc } from "../../api.js";
+import { label, options } from "../../i18n.js";
+import { LEAD_STATUSES, OPEN_LEAD_STATUSES, OBJECTIVES, countryName, waLink, fillTemplate, zonedLocalToISO } from "../../core.js";
+import { $, html, mount, toast } from "../../ui.js";
+import { CONFIG } from "../../config.js";
+import { S, d, dt, relative, isOverdue } from "../state.js";
+import { badge, exportCSV, safeTerm, selectOptions, availabilityText, apiErrorText, confirmDialog } from "../widgets.js";
+
+const PAGE = 50;
+
+function buildQuery(c, f, { all = false } = {}) {
+  let qb = c.from("sms_leads_v").select("*");
+  if (f.mode === "waitlist") qb = qb.eq("status", "waitlist");
+  else if (f.status === "open" || !f.status) qb = qb.in("status", OPEN_LEAD_STATUSES);
+  else if (f.status !== "all") qb = qb.eq("status", f.status);
+  const t = safeTerm(f.q);
+  if (t) qb = qb.or(`full_name.ilike.*${t}*,email.ilike.*${t}*`);
+  if (f.objective) qb = qb.eq("objective", f.objective);
+  if (f.from) qb = qb.gte("registered_at", zonedLocalToISO(f.from + "T00:00", S.tz));
+  if (f.to) qb = qb.lt("registered_at", new Date(new Date(zonedLocalToISO(f.to + "T00:00", S.tz)).getTime() + 86400000).toISOString());
+  if (f.mode === "waitlist") qb = qb.order("waitlist_position", { ascending: true });
+  else if (f.sort === "oldest") qb = qb.order("registered_at", { ascending: true });
+  else if (f.sort === "followup") qb = qb.order("next_follow_up_at", { ascending: true, nullsFirst: false });
+  else if (f.sort === "priority") qb = qb.order("priority_boost", { ascending: false }).order("registered_at", { ascending: true });
+  else qb = qb.order("registered_at", { ascending: false });
+  if (!all) qb = qb.range(f.offset || 0, (f.offset || 0) + PAGE - 1);
+  else qb = qb.limit(5000);
+  return qb;
+}
+
+const CSV_COLUMNS = [
+  { label: "Nombre", key: "full_name" }, { label: "Correo", key: "email" }, { label: "WhatsApp", key: "whatsapp" },
+  { label: "País", value: (r) => countryName(r.country) }, { label: "Estado", value: (r) => label("lead", r.status) },
+  { label: "Posición lista", key: "waitlist_position" }, { label: "Prioridad manual", key: "priority_boost" },
+  { label: "Nivel", value: (r) => label("level", r.english_level) }, { label: "Objetivo", value: (r) => label("objective", r.objective) },
+  { label: "Formato", value: (r) => label("format", r.preferred_format) }, { label: "Disponibilidad", value: (r) => availabilityText(r.availability) },
+  { label: "Fuente", key: "source" }, { label: "Registro", value: (r) => dt(r.registered_at) },
+  { label: "Último contacto", value: (r) => dt(r.last_contact_at) }, { label: "Próximo seguimiento", value: (r) => dt(r.next_follow_up_at) },
+  { label: "Marketing autorizado", value: (r) => (r.consent_marketing ? "Sí" : "No") }
+];
+
+function rowHTML(r, mode) {
+  const flags = html`${r.possible_duplicate_of ? html`<span class="flag">Posible duplicado</span>` : ""}${r.needs_review ? html`<span class="flag">Revisar</span>` : ""}`;
+  const fu = r.next_follow_up_at ? html`<span class="${isOverdue(r.next_follow_up_at) ? "overdue" : ""}"><span class="cell-label">Seguimiento:</span>${dt(r.next_follow_up_at)}</span>` : html`<span class="muted hide-sm">—</span>`;
+  if (mode === "waitlist") {
+    return html`<div class="row" style="--cols: 46px 1.6fr 1.4fr 1.2fr 150px">
+      <b style="font-size:20px;color:var(--plum)">${r.waitlist_position}</b>
+      <a class="name" href="#/persona/${r.student_id}" style="color:inherit;text-decoration:none">${r.full_name}${flags}
+        <span class="sub">En lista ${relative(r.waitlist_joined_at || r.registered_at)} · registro ${d(r.registered_at)}</span></a>
+      <span><span class="cell-label">Busca:</span>${label("objective", r.objective)}<span class="sub">${label("format", r.preferred_format)}</span></span>
+      <span class="small"><span class="cell-label">Disponible:</span>${availabilityText(r.availability) || "—"}</span>
+      <span style="display:flex;gap:6px;align-items:center;justify-content:flex-end;flex-wrap:wrap">
+        <button class="btn btn-soft btn-sm" type="button" data-prio="${r.id}" data-delta="1" aria-label="Subir prioridad de ${r.full_name}" title="Subir prioridad">▲</button>
+        <button class="btn btn-soft btn-sm" type="button" data-prio="${r.id}" data-delta="-1" aria-label="Bajar prioridad de ${r.full_name}" title="Bajar prioridad">▼</button>
+        ${r.whatsapp ? html`<button class="btn btn-primary btn-sm" type="button" data-invite="${r.id}">Invitar</button>` : ""}
+      </span>
+    </div>`;
+  }
+  return html`<a class="row" href="#/persona/${r.student_id}" style="--cols: 2fr 1.1fr 1.3fr 1fr 1.2fr">
+    <span class="name">${r.full_name}${flags}<span class="sub">${r.email}</span></span>
+    ${badge("lead", r.status)}
+    <span><span class="cell-label">Objetivo:</span>${label("objective", r.objective) || "—"}<span class="sub hide-sm">${countryName(r.country)}</span></span>
+    <span><span class="cell-label">Registro:</span>${d(r.registered_at)}</span>
+    ${fu}
+  </a>`;
+}
+
+export async function render(el, params, ctx) {
+  const mode = params.mode === "waitlist" ? "waitlist" : "all";
+  const f = { mode, status: params.status || (mode === "waitlist" ? "waitlist" : "open"), q: params.q || "", objective: params.objective || "", from: params.from || "", to: params.to || "", sort: params.sort || "recent", offset: 0 };
+  let rows = [];
+  let total = 0;
+  const dash = await rpc("sms_dashboard");
+  const pipe = dash.pipeline || {};
+  if (!ctx.isCurrent()) return;
+
+  const order = S.settings.waitlist_order === "joined" ? "fecha de ingreso a la lista" : "fecha de registro";
+  mount(el, html`
+    ${mode === "waitlist" ? html`<div class="panel" style="margin-bottom:14px">
+      <b>Política de orden:</b> primero la <b>prioridad manual</b> (▲ ▼, mayor primero) y luego la <b>${order}</b> (más antiguo primero).
+      ${S.isAdmin ? html`<a href="#/ajustes?s=waitlist">Cambiar política</a>` : ""}
+      <span class="muted small" style="display:block;margin-top:4px">Esta misma regla define la posición que ve cada persona al unirse.</span>
+    </div>` : html`<div class="filters" role="group" aria-label="Filtrar por estado">
+      ${[["open", "Abiertos", OPEN_LEAD_STATUSES.reduce((a, s) => a + (pipe[s] || 0), 0)], ...LEAD_STATUSES.map((s) => [s, label("lead", s), pipe[s] || 0]), ["all", "Todos", Object.values(pipe).reduce((a, b) => a + b, 0)]]
+        .map(([v, t, n]) => html`<button class="filter-chip" type="button" data-status="${v}" aria-pressed="${f.status === v}">${t}<span class="n">${n}</span></button>`)}
+    </div>`}
+    <form class="toolbar" id="lead-filters" role="search">
+      <input class="input search" name="q" type="search" placeholder="Buscar por nombre o correo" value="${f.q}" aria-label="Buscar">
+      <select class="input" name="objective" aria-label="Objetivo">${selectOptions(options("objective"), f.objective, { empty: "Todos los objetivos" })}</select>
+      <input class="input" name="from" type="date" value="${f.from}" aria-label="Registrados desde">
+      <input class="input" name="to" type="date" value="${f.to}" aria-label="Registrados hasta">
+      ${mode === "waitlist" ? "" : html`<select class="input" name="sort" aria-label="Ordenar">
+        ${selectOptions([{ value: "recent", label: "Más recientes" }, { value: "oldest", label: "Más antiguos" }, { value: "followup", label: "Próximo seguimiento" }, { value: "priority", label: "Prioridad" }], f.sort)}
+      </select>`}
+      <button class="btn btn-soft" type="button" id="csv">Exportar CSV</button>
+    </form>
+    <p class="small muted" id="total" aria-live="polite"></p>
+    <div class="rows" id="rows"></div>`);
+
+  const list = $("#rows", el);
+  async function load(reset = true) {
+    if (reset) { f.offset = 0; rows = []; mount(list, html`<div class="loading" style="padding:16px"><span class="spinner"></span> Cargando…</div>`); }
+    const res = await q((c) => buildQuery(c, f));
+    rows = reset ? res : rows.concat(res);
+    const head = mode === "waitlist"
+      ? html`<div class="row head" style="--cols: 46px 1.6fr 1.4fr 1.2fr 150px"><span>#</span><span>Persona</span><span>Busca</span><span>Disponibilidad</span><span></span></div>`
+      : html`<div class="row head" style="--cols: 2fr 1.1fr 1.3fr 1fr 1.2fr"><span>Persona</span><span>Estado</span><span>Objetivo</span><span>Registro</span><span>Seguimiento</span></div>`;
+    mount(list, rows.length
+      ? html`${head}${rows.map((r) => rowHTML(r, mode))}${res.length === PAGE ? html`<button class="more" type="button" id="more">Cargar más</button>` : ""}`
+      : html`<div class="empty-state"><b>${mode === "waitlist" ? "La lista de espera está vacía." : "No hay leads con estos filtros."}</b>
+          ${mode === "waitlist" ? "Quienes se unan desde /lista-de-espera o desde la confirmación del registro aparecerán aquí." : "Prueba con otro estado o borra la búsqueda."}</div>`);
+    $("#total", el).textContent = rows.length ? `${rows.length}${res.length === PAGE ? "+" : ""} resultado${rows.length === 1 ? "" : "s"}` : "";
+    const more = $("#more", el);
+    if (more) more.addEventListener("click", () => { f.offset += PAGE; load(false); });
+  }
+
+  const form = $("#lead-filters", el);
+  let timer;
+  form.addEventListener("input", (e) => {
+    clearTimeout(timer);
+    timer = setTimeout(() => {
+      f.q = form.elements.q.value; f.objective = form.elements.objective.value;
+      f.from = form.elements.from.value; f.to = form.elements.to.value;
+      if (form.elements.sort) f.sort = form.elements.sort.value;
+      load();
+    }, e.target.name === "q" ? 300 : 0);
+  });
+  form.addEventListener("submit", (e) => e.preventDefault());
+  el.querySelectorAll("[data-status]").forEach((b) => b.addEventListener("click", () => {
+    f.status = b.dataset.status;
+    el.querySelectorAll("[data-status]").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
+    load();
+  }));
+  $("#csv", el).addEventListener("click", async () => {
+    const all = await q((c) => buildQuery(c, f, { all: true }));
+    exportCSV(mode === "waitlist" ? "waitlist" : "leads", `${mode === "waitlist" ? "lista-de-espera" : "leads"}-${new Date().toISOString().slice(0, 10)}.csv`, all, CSV_COLUMNS);
+  });
+
+  // Acciones de la lista de espera
+  list.addEventListener("click", async (e) => {
+    const pb = e.target.closest("[data-prio]");
+    if (pb) {
+      const r = rows.find((x) => x.id === pb.dataset.prio);
+      const next = Math.max(-100, Math.min(100, (r.priority_boost || 0) + Number(pb.dataset.delta)));
+      try {
+        await q((c) => c.from("sms_leads").update({ priority_boost: next }).eq("id", r.id));
+        toast(`Prioridad de ${r.full_name}: ${next}`, "ok");
+        load();
+      } catch (err) { toast(apiErrorText(err), "err"); }
+      return;
+    }
+    const ib = e.target.closest("[data-invite]");
+    if (ib) {
+      const r = rows.find((x) => x.id === ib.dataset.invite);
+      const link = new URL("../reservar/", location.href).href;
+      const text = fillTemplate(S.settings.wa_templates && S.settings.wa_templates.invite, { nombre: (r.full_name || "").split(" ")[0], link });
+      window.open(waLink(r.whatsapp, text), "_blank", "noopener");
+      const ok = await confirmDialog({ title: "¿Enviaste la invitación?", text: `Si enviaste el mensaje a ${r.full_name}, marcamos el lead como "Invitación enviada" y sale de la lista.`, confirmLabel: "Sí, marcar como enviada" });
+      if (!ok) return;
+      try {
+        await q((c) => c.from("sms_leads").update({ status: "invitation_sent" }).eq("id", r.id));
+        await q((c) => c.from("sms_activity").insert({ student_id: r.student_id, lead_id: r.id, kind: "contact", summary: "Invitación enviada por WhatsApp", data: { channel: "whatsapp" } }));
+        toast("Invitación registrada.", "ok");
+        ctx.refreshCounts();
+        load();
+      } catch (err) { toast(apiErrorText(err), "err"); }
+    }
+  });
+
+  await load();
+}
diff --git a/sistema/admin/views/payments.js b/sistema/admin/views/payments.js
new file mode 100644
index 0000000..7352aeb
--- /dev/null
+++ b/sistema/admin/views/payments.js
@@ -0,0 +1,98 @@
+/* Pagos — Módulo 5 (seguimiento comercial). Solo owner/admin. */
+import { q } from "../../api.js";
+import { label } from "../../i18n.js";
+import { PAYMENT_STATUSES } from "../../core.js";
+import { $, $$, html, mount, toast } from "../../ui.js";
+import { S, d, money } from "../state.js";
+import { badge, exportCSV, safeTerm, selectOptions, apiErrorText } from "../widgets.js";
+import { paymentDialog } from "../forms.js";
+
+const CSV = [
+  { label: "Fecha registro", value: (r) => d(r.created_at) }, { label: "Estudiante", key: "full_name" }, { label: "Correo", key: "email" },
+  { label: "Concepto", key: "concept" }, { label: "Plan", key: "plan_name" }, { label: "Valor", key: "amount" }, { label: "Moneda", key: "currency" },
+  { label: "Estado", value: (r) => label("payment", r.status) }, { label: "Vencido", value: (r) => (r.overdue ? "Sí" : "No") },
+  { label: "Medio", value: (r) => label("method", r.method) }, { label: "Fecha límite", key: "due_date" }, { label: "Fecha de pago", value: (r) => d(r.paid_at) },
+  { label: "Período desde", key: "period_start" }, { label: "Período hasta", key: "period_end" }, { label: "Referencia", key: "reference" }
+];
+
+export async function render(el, params, ctx) {
+  let filter = params.f === "overdue" ? "overdue" : "all";
+  let rows = [];
+  let term = "";
+
+  mount(el, html`
+    <div class="kpis" id="totals"></div>
+    <div class="filters" role="group" aria-label="Filtrar pagos">
+      ${[["all", "Todos"], ["overdue", "Vencidos"], ...PAYMENT_STATUSES.map((s) => [s, label("payment", s)])].map(([v, t]) =>
+        html`<button class="filter-chip" type="button" data-f="${v}" aria-pressed="${filter === v}">${t}</button>`)}
+    </div>
+    <div class="toolbar">
+      <input class="input search" id="pay-q" type="search" placeholder="Buscar por estudiante o concepto" aria-label="Buscar">
+      <button class="btn btn-soft" type="button" id="csv">Exportar CSV</button>
+      <button class="btn btn-primary" type="button" id="new">Registrar pago</button>
+    </div>
+    <div class="rows" id="rows"></div>`);
+
+  async function totals() {
+    const m0 = new Date(); m0.setDate(1); m0.setHours(0, 0, 0, 0);
+    const [paid, pending] = await Promise.all([
+      q((c) => c.from("sms_payments").select("amount,currency").eq("status", "paid").gte("paid_at", m0.toISOString())),
+      q((c) => c.from("sms_payments_v").select("amount,currency,overdue").eq("status", "pending"))
+    ]);
+    const sum = (list) => Object.entries(list.reduce((a, r) => ({ ...a, [r.currency]: (a[r.currency] || 0) + Number(r.amount) }), {}));
+    const fmt = (e) => (e.length ? e.map(([c, v]) => money(v, c)).join(" + ") : money(0, "USD"));
+    mount($("#totals", el), html`
+      <div class="kpi"><b>${fmt(sum(paid))}</b><span>Cobrado este mes</span></div>
+      <div class="kpi"><b>${fmt(sum(pending))}</b><span>Pendiente por cobrar</span></div>
+      <div class="kpi ${pending.some((p) => p.overdue) ? "alert" : ""}"><b>${pending.filter((p) => p.overdue).length}</b><span>Pagos vencidos</span></div>`);
+  }
+
+  function build(c, all = false) {
+    let qb = c.from("sms_payments_v").select("*");
+    if (filter === "overdue") qb = qb.eq("overdue", true);
+    else if (filter !== "all") qb = qb.eq("status", filter);
+    const t = safeTerm(term);
+    if (t) qb = qb.or(`full_name.ilike.*${t}*,concept.ilike.*${t}*,email.ilike.*${t}*`);
+    return qb.order("created_at", { ascending: false }).limit(all ? 5000 : 200);
+  }
+
+  async function load() {
+    rows = await q((c) => build(c));
+    mount($("#rows", el), rows.length ? html`
+      <div class="row head" style="--cols: 1.6fr 1.4fr 1fr 1fr 1fr auto"><span>Estudiante</span><span>Concepto</span><span>Valor</span><span>Estado</span><span>Fecha</span><span></span></div>
+      ${rows.map((p) => html`<div class="row" style="--cols: 1.6fr 1.4fr 1fr 1fr 1fr auto">
+        <a class="name" href="#/persona/${p.student_id}" style="color:inherit;text-decoration:none">${p.full_name}<span class="sub">${p.email}</span></a>
