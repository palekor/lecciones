+<!doctype html>
+<html lang="es">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Política de tratamiento de datos · ProfGermandario</title>
+  <meta name="description" content="Cómo ProfGermandario recolecta, usa y protege tus datos personales, y cómo ejercer tus derechos.">
+  <meta name="theme-color" content="#16091F">
+  <link rel="icon" href="../profgermandario-logo-clean.png">
+  <link rel="preconnect" href="https://fonts.googleapis.com">
+  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
